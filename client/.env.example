# Copy to .env.local for Vite to pick these up.

# Supabase project — publishable key is safe in the browser.
# Dashboard → Project Settings → API → URL + "anon public" key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# In production, point this at your Render backend. Leave blank in dev (Vite proxies /api).
# VITE_API_BASE=https://your-api.onrender.com
