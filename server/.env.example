# Copy to .env and fill in. NEVER commit .env.

# Long random strings (generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
QR_SECRET=

# Google Sign-In (see README, step 2)
GOOGLE_CLIENT_ID=

COLLEGE_DOMAIN=psgitech.ac.in
# Comma-separated list of teacher emails
TEACHER_EMAILS=teacher1@psgitech.ac.in,teacher2@psgitech.ac.in

# Seconds a QR stays valid before rotating
QR_WINDOW_SECONDS=20

# Local testing only: lets you log in by typing an email, with no Google. Ignored if NODE_ENV=production.
DEV_LOGIN=0

PORT=4000
# Where the SQLite file lives. On a host with a persistent disk, point this at the disk.
# DB_PATH=/var/data/event.db
