# Copy to .env and fill in. NEVER commit .env.

# QR anti-tamper secret used by the server to sign rotating attendance tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=

# Supabase — the backend uses the SERVICE ROLE key to bypass RLS. Keep it secret.
# Dashboard → Project Settings → API → copy "service_role" (NOT the anon key).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Which email domain students must use.
COLLEGE_DOMAIN=psgitech.ac.in

# Comma-separated list of teacher emails. Role is checked server-side on every request,
# never from the token, so this list is the only source of truth.
TEACHER_EMAILS=teacher1@psgitech.ac.in,teacher2@psgitech.ac.in

# Seconds a QR code stays valid before rotating. 0 = a fixed code per event (no rotation).
QR_WINDOW_SECONDS=20

# Verified students can sign in again with just their email (no code). 0 = always require the code.
QUICK_LOGIN=1

PORT=4000

# Comma-separated allowed origins for CORS. Set this to your Vercel URL in production.
# Blank = allow all (fine for local dev only).
# CORS_ORIGIN=https://your-frontend.vercel.app
